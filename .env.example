DATABASE_URL=postgres://user:password@localhost:5432/bridge
REDIS_URL=redis://localhost:6379

# Solana
HELIUS_URL=https://mainnet.helius-rpc.com/?api-key=<key>
SOLANA_WS_URL=wss://mainnet.helius-rpc.com/?api-key=<key>
SOLANA_TOKEN_BRIDGE_PROGRAM=<token bridge program address>

# Optional
WORMHOLE_URL=https://api.wormholescan.io
PORT=8080
ALLOWED_ORIGINS=http://localhost:3000
RUST_LOG=info

# Planned (Phase 1, not read yet): separate Helius keys per lane so the API
# and the ingestion pipeline don't share a rate limit. Fall back to HELIUS_URL.
# HELIUS_API_URL=
# HELIUS_STREAM_URL=


# Solana ingestion is always on (A8). All optional.
# INGEST_ENABLED=1              # 0 disables the ingester (kill switch)
# LIVE_BACKFILL=1               # replay signatures missed since the checkpoint on every (re)connect
# INGEST_BACKFILL_MAX=5000      # most signatures one backfill run publishes
# INGEST_BACKFILL_PACE_MS=750   # pause between backfilled signatures, so publishing
#                               # stays under the live Helius limiter (~4 calls/s)
# INGEST_DEDUPE_TTL_SECS=7200   # remember published signatures this long, 0 disables

# Stream consumer and recovery worker (all optional)
# HELIUS_LIVE_TOKEN_WAIT_MS=20000  # how long a worker waits for its first Helius token
# WORKER_MAX_DELIVERIES=10         # deliveries before a transiently failing message is dead-lettered
# WORKER_RECLAIM_IDLE_MS=300000    # unacked time before recovery reclaims a message
# WORKER_RECLAIM_INTERVAL_SECS=30  # how often recovery sweeps

# Background re-enrichment of Detected and Pending transfers (all optional)
# REENRICH_ENABLED=1
# REENRICH_INTERVAL_SECS=30
# REENRICH_BATCH=50
# REENRICH_MIN_AGE_SECS=60
# REENRICH_RETRY_SECS=120
# REENRICH_MAX_AGE_SECS=604800

# How often the chain registry reloads from Postgres (optional, default 60, minimum 5)
# CHAIN_REGISTRY_REFRESH_SECS=60